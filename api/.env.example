NODE_ENV=development
PORT=4000
#PostGres database configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeMe
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=zinechat
#CDC role for Debezium (search/docker-compose.yml) - not the admin superuser above
CDC_USER=zine_cdc
CDC_PASSWORD=changeMe
#Meilisearch (search/docker-compose.yml) - used by the API to run search queries.
#zine-api isn't on the search stack's network, so reach it the same way
#search/scripts/backfill.sh does: via the host, since Meilisearch's port is published there.
MEILI_HOST=http://host.docker.internal:7700
MEILI_MASTER_KEY=changeMe
#NestJs
NEST_DEBUG=true
#JWT
JWT_ACCESS_TOKEN_EXPIRATION='15m' #15m for testing
JWT_REFRESH_TOKEN_EXPIRATION='1h' #1 day for testing
#Frontend
FRONTEND_PORT=3000
FRONTEND_ULR=http://localhost
#Test debug
# DEBUG=testcontainers*
