# Meilisearch
MEILI_MASTER_KEY=changeMe

# Must match api/.env - Debezium connects to that same database using the dedicated
# CDC_USER/CDC_PASSWORD role (see api/initdb/01-create-cdc-user.sh), not the admin superuser
POSTGRES_DB=test
CDC_USER=zine_cdc
CDC_PASSWORD=changeMe

# Where Debezium POSTs each change event (e.g. a webhook that indexes it into Meilisearch)
DEBEZIUM_SINK_HTTP_URL=http://host.docker.internal:3000/webhooks/debezium
